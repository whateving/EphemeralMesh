# Docker Compose loads .env; the direct Python command does not.
# Export variables before starting the relay, or use systemd's EnvironmentFile.
# Replace this placeholder with a random secret of at least 32 characters.
ADMIN_SECRET=REPLACE_ME
MESH_DB=ephemeral_mesh.db

# Active membership capacity; revoked accounts do not occupy slots.
MESH_MAX_MEMBERS=10
# UTF-8 bytes of ciphertext; protocol ceiling is 48000.
MESH_MAX_MESSAGE_BYTES=48000
# Pending encrypted envelopes, including encrypted receipts.
MESH_MAX_QUEUED_PER_RECIPIENT=1000
MESH_MAX_QUEUED_MESSAGES=10000
# Serialized pending envelope bytes (64 MiB), not physical database file size.
MESH_MAX_QUEUED_BYTES=67108864
# Retained record caps include acknowledged IDs and used/revoked invitations.
MESH_MAX_DELIVERY_RECORDS=100000
MESH_MAX_INVITE_RECORDS=10000
# Authenticated WebSocket frames per connection per one-second window.
MESH_MAX_FRAMES_PER_SECOND=100

# Public Compose deployment: set a domain with DNS pointing to your server.
MESH_DOMAIN=chat.example.com
# Encrypted attachments include encryption overhead; raw local files are capped at 5 MiB.
MESH_MAX_ATTACHMENT_BYTES=8388608
MESH_MAX_ATTACHMENT_TOTAL_BYTES=134217728
MESH_MAX_ATTACHMENT_RECORDS=10000
MESH_MAX_ATTACHMENTS_PER_SENDER=32
