# Identities, auth credentials, plaintext client history, and relay queues are private.
.mesh/
*.db
*.db-shm
*.db-wal
.env
# Local runtimes and generated bytecode do not belong in source control.
venv/
.venv/
__pycache__/
*.pyc

# Encrypted backups still contain private user data and do not belong in source control.
*.embackup
backups/
# Finder metadata is local machine state, not project source.
.DS_Store

# Shareable build artifacts are generated from an explicit source allowlist.
dist/
# Environment variants, key material and captures can contain live credentials.
.env.*
!.env.example
*.pem
*.key
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.pcap
*.pcapng
*.log
*.zip
*.tar.gz
admin-smoke-report.txt
# Original scratch/demo files are preserved locally, outside the published project.
/crypt_test.py
/test
.local-notes/

# Keep raw demo recordings local; only reviewed README assets are published.
/demooo.mov
